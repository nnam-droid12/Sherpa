# Copy to .env and fill in. Never commit .env.
# Gemini runs on Gemini Enterprise Agent Platform (Vertex AI) with Application
# Default Credentials. No Gemini API key is needed.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=nixora-project
GOOGLE_CLOUD_LOCATION=global
SHERPA_GEMINI_MODEL=gemini-3.8-flash
SHERPA_COMPUTER_USE_MODEL=gemini-3.8-flash

# PayPal sandbox only (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-sandbox-webhook-id
PAYPAL_SANDBOX_BUYER_EMAIL=sb-buyer@personal.example.com
PAYPAL_SANDBOX_BUYER_PASSWORD=your-sandbox-buyer-password

# KERNEL cloud browsers (https://dashboard.onkernel.com)
KERNEL_API_KEY=your-kernel-api-key

# Channel3 product search (https://trychannel3.com)
CHANNEL3_API_KEY=your-channel3-api-key

# Fine-grained token limited to the demo store repos (contents + pull requests read/write)
GITHUB_TOKEN=github_pat_xxx

# Shared secret between the console and the agent service
SHERPA_API_KEY=change-me
